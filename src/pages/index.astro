
---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const categories = [
  "All projects",
  "Product design",
  "Mechanical design",
  "Robotics",
  "Vehicle engineering",
  "Student design team",
];

const experience = [
  {
    role: "Mechanical Engineering Intern",
    organization: "ecobee",
    type: "Internship",
    dates: "May 2026 – Present",
    location: "Toronto, Ontario, Canada",
    description: "Contributing to new and current products.",
    current: true,
  },
  {
    role: "Undergraduate Research Assistant",
    organization: "Electrical & Computer Engineering Department @ the University of Toronto",
    type: "Internship",
    dates: "May 2024 – Aug 2024",
    location: "Toronto, Ontario, Canada",
    description:
      "Worked on a human-sized omnidirectional robot in the Energy Systems Lab under Professor Hamid Timorabadi.",
  },
  {
    role: "Junior Intelligent Integrated Systems Designer",
    organization: "Smith + Andersen",
    type: "Contract · Part-time",
    dates: "May 2023 – Apr 2024",
    location: "Toronto, Ontario, Canada",
    description:
      "Contributed to the Downtown Toronto CAMH Hospital 1D Redevelopment Project and internal project tools.",
  },
  {
    role: "Electrical Engineering Intern",
    organization: "IBI Group - Arcadis",
    type: "Internship",
    dates: "May 2022 – Aug 2022",
    location: "Mississauga, Ontario, Canada",
    description:
      "Supported the Vancouver Broadway Subway Project and the City of Toronto Accessibility Upgrade Project.",
  },
];

const projects = [
  {
    number: "01",
    title: "U of T Baja Racing",
    categories: ["Vehicle engineering", "Mechanical design", "Student design team"],
    description: "Tubular chassis CAD design and structural packaging.",
    image: `${base}/images/baja/baja_chassis_render.jpg`,
    color: "sage",
    visual: "CAD · CHASSIS DESIGN",
    href: `${base}/projects/baja`,
  },
  {
    number: "02",
    title: "Omni-directional Robot",
    categories: ["Robotics", "Mechanical design"],
    description:
      "Mechanical assembly, fabricated chassis, and 3D-printed components.",
    image: `${base}/images/omni_robot/omni_robot_physical_assy.jpg`,
    color: "blue",
    visual: "DESIGN · FABRICATION",
    href: `${base}/projects/omni_robot`,
  },
  {
    number: "03",
    title: "Line-Tracking Robo-Duck",
    categories: ["Robotics", "Mechanical design"],
    description:
      "A 3D-printed autonomous robot developed through rapid prototyping and testing.",
    image: `${base}/images/line_tracking_duck/line_tracking_robot_mvp.jpg`,
    color: "yellow",
    visual: "PROTOTYPING · ITERATION",
    href: `${base}/projects/line_tracking_robot/`,
  },
  {
    number: "04",
    title: "Multi-Mechanism CNC Mill",
    categories: ["Product design", "Mechanical design"],
    description:
      "Mechanical subsystems including the bed, spindle, and axis assemblies.",
    image: `${base}/images/multi-mech_CNC_mill/multi_mech_CNC_mill.png`,
    color: "lavender",
    visual: "CAD · MECHANICAL SYSTEMS",
    href: `${base}/projects/cnc-mill/`,
  },
  {
    number: "05",
    title: "UTAT UAS Mechanical Systems",
    categories: ["Mechanical design", "Student design team"],
    description: "CAD development of a baffle system and winch mechanism.",
    image: `${base}/images/UTAT_UAS/UTAT_UAS_baffle_system_CAD.png`,
    color: "mint",
    visual: "CAD · MECHANISM DESIGN",
    href: `${base}/projects/utat-uas/`,
  },
  {
    number: "06",
    title: "Gyroscopic Salad Spinner",
    categories: ["Product design", "Mechanical design"],
    description:
      "CAD modelling and physical prototyping of a geared, nested-ring mechanism.",
    image: `${base}/images/gyro_salad/gyroscope_front.jpg`,
    color: "yellow",
    visual: "CAD · MECHANISM · PROTOTYPE",
    href: `${base}/projects/gyro_salad`,
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Qin Bei's mechanical engineering portfolio featuring product development, CAD, robotics, and mechanical design."
    />
    <meta name="theme-color" content="#f7f5ef" />
    <title>Qin Bei — Engineering Portfolio</title>
  </head>

  <body>
    <header class="nav">
      <a class="wordmark" href={`${base}/`}>
        Qin Bei<span>.</span>
      </a>

      <nav aria-label="Main navigation">
        <a href="#work">Projects</a>
        <a href="#about">About</a>
        <a href="#experience">Experience</a>
        <a href="#contact">Contact ↗</a>
      </nav>
    </header>

    <main>
      <section class="intro" id="home">
        <div class="intro-copy">

          <h1>
            I like making<br />
            things <span class="intro-accent">for people</span><span class="period">.</span>
          </h1>

          <p class="intro-description">
            Mechanical engineering, product development, integrated systems and fun stuff

          </p>
        </div>

        <a class="explore-link" href="#work">
          EXPLORE MY PROJECTS <span>↓</span>
        </a>
      </section>

      <section class="work" id="work">
        <div class="work-heading">
          <div>
            <p class="eyebrow">A SELECTION OF PROJECTS I'VE WORKED ON</p>
            <h2>Selected projects<span class="period">.</span></h2>
          </div>

          <p class="work-count">
            <span id="project-count">{projects.length}</span> PROJECTS
          </p>
        </div>

        <div class="filters" aria-label="Filter projects">
          {categories.map((category, index) => (
            <button
              type="button"
              class={index === 0 ? "filter active" : "filter"}
              data-filter={category}
              aria-pressed={index === 0 ? "true" : "false"}
            >
              {category}
            </button>
          ))}
        </div>

        <div class="project-grid" id="project-grid">
          {projects.map((project) => (
            <article class="project-card" data-categories={project.categories.join("|")}>
              <a
                class="project-link"
                href={project.href}
                aria-label={`View ${project.title}`}
              >
                <div class={`project-image ${project.color}`}>
                  <img
                    class="project-photo"
                    src={project.image}
                    alt={project.title}
                    loading="lazy"
                  />

                  <span class="project-number">{project.number}</span>
                  <span class="image-caption">{project.visual}</span>
                  <span class="card-arrow" aria-hidden="true">↗</span>
                </div>

                <div class="project-info">
                  <div class="project-categories" aria-label="Project categories">
                    {project.categories.map((category) => (
                      <span class="project-category">{category}</span>
                    ))}
                  </div>
                  <h3>{project.title}</h3>
                  <p class="project-description">
                    {project.description}
                  </p>
                </div>
              </a>
            </article>
          ))}
        </div>

      </section>

      <section class="about" id="about">
        <p class="eyebrow">A LITTLE ABOUT ME</p>

        <div class="about-grid">
          <h2>
            Creative by nature.<br />
            <span>Practical by design.</span>
          </h2>

          <figure class="about-photo">
            <img
              src={`${base}/images/about/me%20welding.jpg`}
              alt="Qin Bei welding a metal frame in the workshop"
              loading="lazy"
            />
            <figcaption>IN THE WORKSHOP · WELDING</figcaption>
          </figure>

          <div class="about-copy">
            <p>
              My name is Qin Bei. I'm a mechanical engineering student at the 
              Univeristy of Toronto. I'm constantly inspired by people and 
              by how thoughtful design can make everyday products more useful
              and complex systems work better. I like the idea of people 
              creating things for people—the cycle of curiosity, creativity, 
              and problem solving that keeps the world moving forward. 
              It's a cycle I hope to contribute to as an engineer.
              
 
            </p>

            <p>
              I enjoy turning ideas into reality through CAD, prototyping,
              fabrication, integration, testing, and iterative problem-solving.

              Thank you for taking the time to look at my portfolio!
            </p>
          </div>
        </div>
      </section>

      <section class="experience" id="experience">
        <div class="experience-heading">
          <div>
            <p class="eyebrow">WHERE I'VE CONTRIBUTED</p>
            <h2>Experience<span class="period">.</span></h2>
          </div>
          <p class="experience-count">{experience.length} ROLES</p>
        </div>

        <ol class="experience-list">
          {experience.map((item) => (
            <li class="experience-item">
              <div class="experience-date">
                <span>{item.dates}</span>
              </div>
              <article class="experience-card">
                <div class="experience-title-row">
                  <div>
                    <h3>{item.role}</h3>
                    <p class="experience-organization">
                      {item.organization} <span>· {item.type}</span>
                    </p>
                  </div>
                  {item.current && <span class="current-badge">CURRENT</span>}
                </div>
                <p class="experience-location">{item.location}</p>
                <p class="experience-description">{item.description}</p>
              </article>
            </li>
          ))}
        </ol>
      </section>

      <section class="contact" id="contact">
        <p class="eyebrow">LET'S CONNECT</p>

        <h2>
          Cool things?<br />
          Count me in<span class="period">!</span>
        </h2>

        <p>
          Let's connect!
        </p>

        <a class="contact-link" href="mailto:qin.bei@mail.utoronto.ca">
          Get in touch ↗
        </a>
      </section>
    </main>

    <footer>
      <span>© {new Date().getFullYear()} Qin Bei</span>
      <span>MADE WITH CURIOSITY.</span>
      <a href="#home">BACK TO TOP ↑</a>
    </footer>
  </body>
</html>

<script>
  const filters = document.querySelectorAll(".filter");
  const cards = document.querySelectorAll(".project-card");
  const count = document.querySelector("#project-count");

  filters.forEach((filter) => {
    filter.addEventListener("click", () => {
      const selected = filter.getAttribute("data-filter") || "All projects";
      let visibleCount = 0;

      filters.forEach((button) => {
        const active = button === filter;
        button.classList.toggle("active", active);
        button.setAttribute("aria-pressed", String(active));
      });

      cards.forEach((card) => {
        const cardCategories = (card.getAttribute("data-categories") || "").split("|");
        const visible =
          selected === "All projects" || cardCategories.includes(selected);

        card.hidden = !visible;

        if (visible) visibleCount++;
      });

      if (count) count.textContent = String(visibleCount);
    });
  });
</script>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 85px;
  }

  :global(body) {
    margin: 0;
    background: #f7f5ef;
    color: #252620;
    font-family: Arial, Helvetica, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  .nav {
    min-height: 72px;
    padding: 0 6%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .wordmark {
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.7px;
  }

  .wordmark span,
  .period,
  .intro-accent {
    color: #648365;
  }

  nav {
    display: flex;
    gap: clamp(18px, 3vw, 42px);
  }

  nav a {
    font-size: 12px;
    color: #55574f;
  }

  nav a:hover {
    color: #648365;
  }

  .intro {
    min-height: 290px;
    padding: 48px 6% 32px;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 32px;
    background: #f1e5c7;
  }

  .eyebrow {
    color: #74766b;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    line-height: 1.7;
  }

  .intro .eyebrow {
    margin-bottom: 18px;
  }

  h1 {
    margin: 0;
    font-size: clamp(45px, 6.7vw, 88px);
    line-height: 0.98;
    font-weight: 500;
    letter-spacing: -0.075em;
  }

  .intro-description {
    max-width: 450px;
    margin: 23px 0 0;
    color: #696b61;
    font-size: 14px;
    line-height: 1.8;
  }

  .explore-link {
    flex-shrink: 0;
    display: inline-flex;
    gap: 22px;
    align-items: center;
    margin-bottom: 5px;
    padding-bottom: 9px;
    border-bottom: 1px solid #9b9b8e;
    font-size: 10px;
    letter-spacing: 0.8px;
  }

  .explore-link span {
    color: #648365;
  }

  .work {
    padding: 36px 6% 80px;
  }

  .work-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
    margin-bottom: 24px;
  }

  .work-heading .eyebrow {
    margin-bottom: 9px;
  }

  h2 {
    margin: 0;
    font-size: clamp(30px, 4vw, 46px);
    font-weight: 500;
    letter-spacing: -0.06em;
  }

  .work-count {
    margin: 0 0 5px;
    color: #77786f;
    font-size: 10px;
    letter-spacing: 1px;
    white-space: nowrap;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 28px;
  }

  .filter {
    border: 1px solid #dfdcd1;
    border-radius: 999px;
    background: transparent;
    color: #55574f;
    padding: 9px 14px;
    font-family: inherit;
    font-size: 11px;
    cursor: pointer;
  }

  .filter:hover {
    border-color: #8a9d85;
  }

  .filter.active {
    background: #344936;
    border-color: #344936;
    color: #fff;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 38px 18px;
  }

  .project-card {
    min-width: 0;
  }

  .project-card[hidden] {
    display: none;
  }

  .project-link {
    display: block;
    cursor: pointer;
  }

  .project-image {
    position: relative;
    aspect-ratio: 1.13 / 1;
    overflow: hidden;
    isolation: isolate;
    background: #e3e5dc;
  }

  .sage {
    background: #dce6d7;
  }

  .blue {
    background: #dce8f6;
  }

  .yellow {
    background: #f3e4b6;
  }

  .coral {
    background: #f0d8cc;
  }

  .lavender {
    background: #e5def1;
  }

  .mint {
    background: #d4e7df;
  }

  .project-photo {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 250ms ease;
  }

  .project-card:hover .project-photo {
    transform: scale(1.035);
  }

  .project-number,
  .image-caption {
    position: absolute;
    z-index: 2;
    color: #444940;
    background: rgba(247, 245, 239, 0.9);
    padding: 6px 8px;
    font-size: 9px;
    letter-spacing: 0.7px;
  }

  .project-number {
    top: 12px;
    left: 12px;
  }

  .image-caption {
    bottom: 12px;
    left: 12px;
    font-size: 8px;
  }

  .card-arrow {
    position: absolute;
    top: 10px;
    right: 12px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(247, 245, 239, 0.9);
    color: #33372f;
    font-size: 17px;
    transition: transform 180ms ease;
  }

  .project-card:hover .card-arrow {
    transform: translate(2px, -2px);
  }

  .project-info {
    padding-top: 15px;
  }

  .project-categories {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 7px;
  }

  .project-category {
    display: inline-block;
    margin: 0;
    padding: 4px 7px;
    border: 1px solid #dfdcd1;
    border-radius: 999px;
    color: #6b806b;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
  }

  .project-info h3 {
    margin: 0 0 7px;
    font-size: 17px;
    line-height: 1.35;
    font-weight: 500;
    letter-spacing: -0.4px;
  }

  .project-description {
    margin: 0;
    color: #707168;
    font-size: 12px;
    line-height: 1.7;
  }

  .gallery-note {
    margin: 38px 0 0;
    color: #7b7c72;
    font-size: 11px;
  }

  .about {
    padding: 70px 6%;
    background: #e8eddf;
  }

  .about > .eyebrow {
    margin-bottom: 24px;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.8fr 0.65fr;
    align-items: start;
    gap: 36px;
  }

  .about-grid h2 {
    font-size: clamp(32px, 4.5vw, 55px);
    line-height: 1.13;
  }

  .about-grid h2 span {
    color: #788775;
  }

  .about-copy p {
    color: #55594f;
    font-size: 13px;
    line-height: 1.9;
  }

  .about-photo {
    margin: 0;
  }

  .about-photo img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center;
  }

  .about-photo figcaption {
    padding-top: 10px;
    color: #687064;
    font-size: 9px;
    letter-spacing: 1px;
  }

  .experience {
    padding: 70px 6%;
  }

  .experience-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 30px;
  }

  .experience-heading .eyebrow {
    margin: 0 0 9px;
  }

  .experience-heading h2 {
    margin: 0;
    font-size: clamp(30px, 4vw, 46px);
    font-weight: 500;
    letter-spacing: -0.06em;
  }

  .experience-count {
    margin: 0 0 5px;
    color: #77786f;
    font-size: 10px;
    letter-spacing: 1px;
    white-space: nowrap;
  }

  .experience-list {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    margin: 0;
    padding: 25px 0 0;
    list-style: none;
  }

  .experience-list::before {
    position: absolute;
    top: 4px;
    right: 0;
    left: 0;
    height: 1px;
    background: #dcd9cf;
    content: "";
  }

  .experience-item {
    position: relative;
    min-width: 0;
  }

  .experience-date {
    position: relative;
    margin-bottom: 14px;
    color: #73756b;
    font-size: 11px;
    line-height: 1.6;
  }

  .experience-date::after {
    position: absolute;
    top: -22px;
    left: 0;
    width: 9px;
    height: 9px;
    border: 2px solid #f7f5ef;
    border-radius: 50%;
    background: #648365;
    content: "";
  }

  .experience-card {
    min-width: 0;
  }

  .experience-title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
  }

  .experience-card h3 {
    margin: 0 0 4px;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.3px;
  }

  .experience-organization,
  .experience-location,
  .experience-description {
    margin: 0;
    font-size: 12px;
    line-height: 1.7;
  }

  .experience-organization {
    color: #363830;
  }

  .experience-organization span,
  .experience-location {
    color: #77786f;
  }

  .experience-location {
    margin-top: 3px;
  }

  .experience-description {
    margin-top: 10px;
    color: #5e6057;
  }

  .current-badge {
    flex-shrink: 0;
    padding: 5px 8px;
    border-radius: 999px;
    background: #e4eee1;
    color: #476448;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.8px;
  }

  .contact {
    padding: 75px 6%;
    background: #f1e5c7;
  }

  .contact .eyebrow {
    margin-bottom: 20px;
  }

  .contact h2 {
    font-size: clamp(36px, 5vw, 64px);
    line-height: 1.08;
  }

  .contact > p:not(.eyebrow) {
    max-width: 460px;
    margin-top: 20px;
    color: #676356;
    font-size: 13px;
    line-height: 1.8;
  }

  .contact-link {
    display: inline-block;
    margin-top: 12px;
    padding-bottom: 7px;
    border-bottom: 1px solid #88816b;
    font-size: 13px;
  }

  .contact-link:hover {
    color: #648365;
  }

  footer {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 25px 6%;
    color: #77786f;
    font-size: 9px;
    letter-spacing: 0.7px;
  }

  @media (min-width: 1500px) {
    .nav,
    .intro,
    .work,
    .about,
    .experience,
    .contact,
    footer {
      padding-left: max(6%, calc((100% - 1320px) / 2));
      padding-right: max(6%, calc((100% - 1320px) / 2));
    }
  }

  @media (max-width: 900px) {
    .experience-list {
      grid-template-columns: 1fr;
      gap: 0;
      padding-top: 0;
    }

    .experience-list::before {
      top: 8px;
      right: auto;
      bottom: 8px;
      left: 4px;
      width: 1px;
      height: auto;
    }

    .experience-item {
      display: grid;
      grid-template-columns: 1fr;
      gap: 6px;
      padding: 20px 0 20px 24px;
      border-top: 1px solid #e4e1d7;
    }

    .experience-date {
      margin-bottom: 0;
      text-align: left;
    }

    .experience-date::after {
      top: 5px;
      left: -24px;
      right: auto;
    }
  }

  @media (max-width: 760px) {
    .intro {
      min-height: auto;
      padding-top: 55px;
      align-items: start;
      flex-direction: column;
      gap: 25px;
    }

    .intro-description {
      max-width: 400px;
    }

    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 30px 13px;
    }

    .project-info h3 {
      font-size: 15px;
    }

    .about-grid {
      grid-template-columns: 1fr 0.7fr;
      gap: 24px;
    }

    .about-grid h2 {
      grid-column: 1;
      grid-row: 1;
    }

    .about-photo {
      grid-column: 2;
      grid-row: 1 / span 2;
    }

