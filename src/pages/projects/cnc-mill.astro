
---
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;

const project = {
  timeline: "September – December 2024",
  role: "Mechanical Design · CAD",
  tools: "SolidWorks · ANSYS",
  group: "Arnav S. · Brian H. · Ali A.",
  course: "MIE243 · Mechanical Engineering Design",
};

const gallery = [
  {
    src: `${base}images/multi-mech_CNC_mill/multi_mech_CNC_mill_x-axis.png`,
    alt: "Detailed front view of the CNC mill X-axis assembly",
    caption: "X-AXIS ASSEMBLY",
    size: "wide",
  },
  {
    src: `${base}images/multi-mech_CNC_mill/multi_mech_CNC_mill_z-axis.png`,
    alt: "Z-axis housing component",
    caption: "Z-AXIS HOUSING",
  },
  {
    src: `${base}images/multi-mech_CNC_mill/multi_mech_CNC_mill_spindle.png`,
    alt: "Spindle housing component",
    caption: "SPINDLE HOUSING",
  },
  {
    src: `${base}images/multi-mech_CNC_mill/multi_mech_CNC_mill_bed.png`,
    alt: "Modular CNC mill bed design",
    caption: "MODULAR BED",
  },
  {
    src: `${base}images/multi-mech_CNC_mill/multi_mech_CNC_mill_safety_stop.png`,
    alt: "CNC mill frame and safety stop button location",
    caption: "SAFETY & FRAME",
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Multi-mechanism CNC mill design project featuring mechanical design, SolidWorks CAD, and three-axis motion."
    />
    <meta name="theme-color" content="#f7f5ef" />
    <title>Multi-Mechanism CNC Mill — Qin Bei</title>
  </head>

  <body>
    <header class="nav">
      <a class="wordmark" href={base}>Qin Bei<span>.</span></a>
      <nav aria-label="Main navigation">
        <a href={`${base}#work`}>Projects</a>
        <a href={`${base}#about`}>About</a>
        <a href={`${base}#experience`}>Experience</a>
        <a href={`${base}#contact`}>Contact ↗</a>
      </nav>
    </header>

    <main>
      <!-- PROJECT HEADER -->
      <section class="hero">
        <div class="hero-copy">
          <a class="back-link" href={`${base}#work`}>← All projects</a>
          <p class="eyebrow">PRODUCT DESIGN · MECHANICAL DESIGN</p>
          <h1>Multi-Mechanism<br />CNC Mill<span>.</span></h1>
          <p class="subtitle">
            Designing a three-axis CNC mill by integrating mechanical
            motion systems, modular workholding, and safety features.
          </p>
        </div>

        <div class="metadata">
          <div>
            <span class="meta-label">TIMELINE</span>
            <span>{project.timeline}</span>
          </div>
          <div>
            <span class="meta-label">ROLE</span>
            <span>{project.role}</span>
          </div>
          <div>
            <span class="meta-label">TOOLS</span>
            <span>{project.tools}</span>
          </div>
          <div>
            <span class="meta-label">GROUP</span>
            <span>{project.group}</span>
          </div>
        </div>
      </section>

      <!-- 01: PROJECT OVERVIEW -->
      <section class="section">
        <div class="section-index">01</div>

        <div class="section-content overview">
          <h2>Project overview</h2>

          <p>
            As part of MIE243 Mechanical Engineering Design at the
            University of Toronto, I worked with a team of four to
            research, document, and design a three-axis CNC mill.
            The project focused on developing a functional machine
            concept for hobbyists and beginners in small workshops
            and home garages.
          </p>

          <p>
            Our team evaluated candidate designs against engineering
            specifications, considering manufacturing methods,
            component costs, user requirements, market research,
            stability, safety, and compatibility with commonly
            available tools. We delivered a fully assembled CAD model
            and a written report detailing the mechanical design.
          </p>
        </div>
      </section>

      <!-- 02: PROPOSED SOLUTION -->
      <section class="section">
        <div class="section-index">02</div>

        <div class="section-content">
          <h2>Proposed solution</h2>

          <p class="section-intro">
            The proposed CNC mill integrates multiple motion mechanisms,
            a modular work surface, and safety considerations into a
            complete CAD assembly for small workshops and home garages.
          </p>

          <div class="design-grid">
            <article class="design-item">
              <span class="design-symbol">↔</span>
              <h3>Three-axis motion</h3>
              <p>
                Rack-and-pinion motion drives the X-axis, while lead
                screws and guide rods support movement along the Y-
                and Z-axes. The spindle assembly moves along the X-axis,
                with vertical positioning provided by the Z-axis system.
              </p>
            </article>

            <article class="design-item">
              <span class="design-symbol">⌘</span>
              <h3>Modular integration</h3>
              <p>
                A modular bed slides into slots along the Y-axis
                housing to accommodate different workshop needs.
                The frame, axis housings, drive mechanisms, and
                spindle are integrated into a complete CAD assembly.
              </p>
            </article>

            <article class="design-item">
              <span class="design-symbol">!</span>
              <h3>Safety and usability</h3>
              <p>
                The design incorporates workpiece clamps and a proposed
                emergency stop button intended to cut electrical power
                to the motors. The proposed stop system is independent
                and positioned for visibility and accessibility.
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- 03: MY CONTRIBUTIONS -->
      <section class="section contributions-section">
        <div class="section-index">03</div>

        <div class="section-content">
          <h2 class="contributions-heading">My contributions</h2>

          <div class="contributions-grid">
            <article class="contribution-item">
              <div class="contribution-icon icon-green" aria-hidden="true">
                ◇
              </div>

              <div class="contribution-copy">
                <p class="contribution-category">RESEARCH & DEVELOPMENT</p>
                <h3>Concept development</h3>
                <p>
                  Researched design alternatives and evaluated candidate
                  concepts against engineering specifications, component
                  costs, manufacturing methods, and user requirements.
                </p>
              </div>
            </article>

            <article class="contribution-item">
              <div class="contribution-icon icon-blue" aria-hidden="true">
                ○
              </div>

              <div class="contribution-copy">
                <p class="contribution-category">CAD & VISUALIZATION</p>
                <h3>Mechanical design</h3>
                <p>
                  Contributed to the SolidWorks design of the CNC mill,
                  including mechanical housings, the spindle assembly,
                  and modular bed, helping communicate the proposed
                  three-axis machine architecture.
                </p>
              </div>
            </article>

            <article class="contribution-item">
              <div class="contribution-icon icon-yellow" aria-hidden="true">
                +
              </div>

              <div class="contribution-copy">
                <p class="contribution-category">SYSTEM INTEGRATION</p>
                <h3>Assembly & design evaluation</h3>
                <p>
                  Helped integrate mechanical components into a complete
                  CAD assembly, considering manufacturability, stability,
                  safety features, and compatibility with commonly
                  available tools.
                </p>
              </div>
            </article>
          </div>
        </div>
      </section>

      <!-- 04: CAD GALLERY -->
      <section class="section gallery-section">
        <div class="section-index">04</div>

        <div class="section-content">
          <div class="gallery-heading">
            <div>
              <p class="eyebrow">SELECTED PROJECT IMAGES</p>
              <h2>Inside the design<span>.</span></h2>
            </div>
            <span class="image-count">{gallery.length} IMAGES</span>
          </div>

          <div class="gallery-grid">
            {gallery.map((item, index) => (
              <figure class:list={["gallery-item", item.size]}>
                <a
                  class="gallery-image"
                  href={item.src}
                  target="_blank"
                  rel="noreferrer"
                  aria-label={`Open full-size image: ${item.alt}`}
                >
                  <img
                    src={item.src}
                    alt={item.alt}
                    loading="lazy"
                  />
                  <span class="image-open" aria-hidden="true">↗</span>
                </a>

                <figcaption>
                  <span>{item.caption}</span>
                  <span class="gallery-index">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>

      <!-- MORE PROJECTS -->
      <section class="next-project">
        <p class="eyebrow">MORE PROJECTS</p>
        <h2>More things I've been building<span>.</span></h2>
        <a href={`${base}#work`}>Back to selected projects ↗</a>
      </section>
    </main>

    <footer>
      <a class="wordmark" href={base}>Qin Bei<span>.</span></a>
      <span>MECHANICAL ENGINEERING</span>
      <a href={`${base}#contact`}>GET IN TOUCH ↗</a>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 80px;
  }

  :global(body) {
    margin: 0;
    background: #f7f5ef;
    color: #252620;
    font-family: Arial, Helvetica, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  /* HEADER */
  .nav {
    min-height: 72px;
    padding: 0 5.5%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #dedbd2;
  }

  .wordmark {
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.7px;
  }

  .wordmark span,
  h1 span,
  h2 span,
  .next-project h2 span {
    color: #648365;
  }

  nav {
    display: flex;
    gap: clamp(18px, 3vw, 42px);
  }

  nav a {
    color: #55574f;
    font-size: 12px;
    transition: color 180ms ease;
  }

  nav a:hover,
  .back-link:hover {
    color: #648365;
  }

  h1,
  h2,
  h3 {
    font-weight: 500;
  }

  .eyebrow,
  .meta-label {
    color: #72766b;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 1.4px;
    line-height: 1.7;
  }

  h2 {
    margin: 0 0 18px;
    font-size: clamp(28px, 3.1vw, 40px);
    line-height: 1.12;
    letter-spacing: -0.065em;
  }

  /* PROJECT HEADER */
  .hero {
    display: block;
    padding: 34px 5.5% 32px;
  }

  .hero-copy {
    min-width: 0;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 28px;
    color: #686a60;
    font-size: 12px;
  }

  .hero-copy > .eyebrow {
    margin: 0 0 16px;
  }

  h1 {
    margin: 0;
    font-size: clamp(42px, 5.2vw, 72px);
    line-height: 1.02;
    letter-spacing: -0.075em;
  }

  .subtitle {
    max-width: 650px;
    margin: 20px 0 0;
    color: #686961;
    font-size: 14px;
    line-height: 1.85;
  }

  figure {
    min-width: 0;
    margin: 0;
  }

  figcaption {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 0;
    color: #72746b;
    font-size: 9px;
    letter-spacing: 0.9px;
    line-height: 1.6;
  }

  /* PROJECT METADATA */
  .metadata {
    display: grid;
    grid-template-columns: 0.8fr 1fr 1.3fr 1fr;
    gap: 24px;
    max-width: 900px;
    margin-top: 30px;
    padding-top: 18px;
    border-top: 1px solid #dedbd2;
  }

  .metadata > div {
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding-right: 15px;
  }

  .metadata > div + div {
    padding-left: 24px;
    border-left: 1px solid #d7d4cb;
  }

  .metadata > div > span:last-child {
    font-size: 12px;
    line-height: 1.65;
  }

  /* CONTENT SECTIONS */
  .section {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    column-gap: 14px;
    margin: 0 5.5%;
    padding: 32px 0;
    border-top: 1px solid #dedbd2;
  }

  .section-index {
    padding-top: 3px;
    color: #648365;
    font-size: 11px;
  }

  .section-content {
    min-width: 0;
  }

  .section-content > .eyebrow {
    margin: 0 0 10px;
  }

  .overview {
    max-width: 900px;
  }

  .overview h2 {
    max-width: 700px;
  }

  .overview p:not(.eyebrow),
  .section-intro {
    max-width: 850px;
    color: #65675e;
    font-size: 13px;
    line-height: 1.85;
  }

  .overview p:not(.eyebrow) {
    margin: 0 0 16px;
  }

  .overview p:last-child {
    margin-bottom: 0;
  }

  .section-intro {
    margin: 0 0 24px;
  }

  /* PROPOSED SOLUTION */
  .design-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-top: 26px;
  }

  .design-item {
    min-width: 0;
    padding: 20px;
    background: #eee9dc;
  }

  .design-symbol {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    margin-bottom: 20px;
    border-radius: 50%;
    background: #e1e7d7;
    color: #476448;
    font-size: 18px;
  }

  .design-item h3 {
    margin: 0 0 9px;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.4px;
  }

  .design-item p {
    margin: 0;
    color: #65675e;
    font-size: 12px;
    line-height: 1.8;
  }

  /* MY CONTRIBUTIONS */
  .contributions-section {
    padding-top: 30px;
    padding-bottom: 30px;
  }

  .contributions-heading {
    margin: 0 0 24px;
    font-size: clamp(32px, 3.5vw, 48px);
    line-height: 1.05;
    letter-spacing: -0.075em;
  }

  .contributions-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .contribution-item {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    align-content: start;
    gap: 16px;
    min-width: 0;
    padding: 0 24px;
  }

  .contribution-item:first-child {
    padding-left: 0;
  }

  .contribution-item:last-child {
    padding-right: 0;
  }

  .contribution-item + .contribution-item {
    border-left: 1px solid #d7d4cb;
  }

  .contribution-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    font-size: 25px;
    line-height: 1;
  }

  .icon-green {
    background: #e1e7d7;
    color: #476448;
  }

  .icon-blue {
    background: #dce7ef;
    color: #365d7c;
  }

  .icon-yellow {
    background: #f7e6b9;
    color: #80652a;
  }

  .contribution-copy {
    min-width: 0;
  }

  .contribution-category {
    margin: 2px 0 9px;
    color: #72766b;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 1.2px;
    line-height: 1.5;
  }

  .contribution-copy h3 {
    margin: 0 0 12px;
    font-size: clamp(17px, 1.5vw, 22px);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.045em;
  }

  .contribution-copy > p:last-child {
    margin: 0;
    color: #65675e;
    font-size: 13px;
    line-height: 1.8;
  }

  /* CAD GALLERY */
  .gallery-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
    margin-bottom: 20px;
  }

  .gallery-heading .eyebrow {
    margin: 0 0 8px;
  }

  .gallery-heading h2 {
    margin: 0;
  }

  .image-count {
    padding-bottom: 5px;
    color: #72766b;
    font-size: 10px;
    letter-spacing: 1px;
    white-space: nowrap;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 26px 18px;
  }

  .gallery-item {
    min-width: 0;
    margin: 0;
  }

  .gallery-item.wide {
    grid-column: span 2;
  }

  .gallery-image {
    position: relative;
    display: block;
    overflow: hidden;
    background: transparent;
  }

  .gallery-image img {
    display: block;
    width: 100%;
    aspect-ratio: 1.25 / 1;
    object-fit: contain;
    background: transparent;
    transition: transform 250ms ease;
  }

  .gallery-item.wide .gallery-image img {
    aspect-ratio: 1.55 / 1;
  }

  .gallery-image:hover img {
    transform: scale(1.025);
  }

  .image-open {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #f7f5ef;
    color: #252620;
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .gallery-image:hover .image-open,
  .gallery-image:focus-visible .image-open {
    opacity: 1;
  }

  .gallery-index {
    color: #648365;
  }

  /* MORE PROJECTS */
  .next-project {
    margin-top: 8px;
    padding: 36px 5.5% 45px;
    background: #eee9dc;
  }

  .next-project .eyebrow {
    margin: 0 0 12px;
  }

  .next-project h2 {
    margin-bottom: 20px;
    font-size: clamp(30px, 4vw, 46px);
    line-height: 1.08;
    letter-spacing: -0.07em;
  }

  .next-project > a {
    display: inline-block;
    padding-bottom: 7px;
    border-bottom: 1px solid #999b8d;
    font-size: 12px;
  }

  /* FOOTER */
  footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 24px 5.5%;
    color: #77786f;
    font-size: 9px;
    letter-spacing: 0.7px;
  }

  /* LARGE SCREENS */
  @media (min-width: 1500px) {
    .nav,
    .hero,
    .next-project,
    footer {
      padding-left: max(5.5%, calc((100% - 1320px) / 2));
      padding-right: max(5.5%, calc((100% - 1320px) / 2));
    }

    .section {
      margin-left: max(5.5%, calc((100% - 1320px) / 2));
      margin-right: max(5.5%, calc((100% - 1320px) / 2));
    }
  }

  /* TABLETS */
  @media (max-width: 900px) {
    .contributions-grid {
      grid-template-columns: 1fr;
      gap: 22px;
    }

    .contribution-item,
    .contribution-item:first-child,
    .contribution-item:last-child {
      padding: 0;
    }

    .contribution-item + .contribution-item {
      padding-top: 22px;
      border-top: 1px solid #d7d4cb;
      border-left: 0;
    }

    .contribution-copy h3 {
      font-size: 20px;
    }
  }

  @media (max-width: 760px) {
    .metadata {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .metadata > div + div {
      padding-left: 0;
      border-left: 0;
    }

    .metadata > div:nth-child(even) {
      padding-left: 16px;
      border-left: 1px solid #d7d4cb;
    }

    .design-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .design-item {
      padding: 18px;
    }

    .gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .gallery-item.wide {
      grid-column: span 2;
    }
  }

  /* PHONES */
  @media (max-width: 480px) {
    .nav {
      min-height: 64px;
      padding: 0 5%;
    }

    nav {
      gap: 13px;
    }

    nav a {
      font-size: 10px;
    }

    .hero {
      padding: 22px 5% 26px;
    }

    .back-link {
      margin-bottom: 28px;
    }

    h1 {
      font-size: clamp(42px, 11vw, 52px);
    }

    .subtitle {
      font-size: 13px;
    }

    .section {
      grid-template-columns: 22px minmax(0, 1fr);
      gap: 10px;
      margin: 0 5%;
      padding: 24px 0;
    }

    .metadata {
      grid-template-columns: 1fr;
      gap: 15px;
    }

    .metadata > div + div {
      padding-left: 0;
      border-left: 0;
    }

    .gallery-grid {
      grid-template-columns: 1fr;
    }

    .gallery-item.wide {
      grid-column: auto;
    }

    .metadata > div:first-child {
      padding-right: 0;
    }

    .metadata > div > span:last-child {
      font-size: 10px;
    }

    .contributions-heading {
      font-size: 34px;
    }

    .contribution-item {
      grid-template-columns: 38px minmax(0, 1fr);
      gap: 13px;
    }

    .contribution-icon {
      width: 38px;
      height: 38px;
      font-size: 22px;
    }

    .contribution-copy > p:last-child {
      font-size: 12px;
    }

    .gallery-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .gallery-item.wide {
      grid-column: auto;
    }

    .gallery-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
    }

    .next-project {
      padding: 30px 5% 38px;
    }

    footer {
      flex-wrap: wrap;
      padding: 20px 5%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }

    .gallery-image img {
      transition: none;
    }
  }
</style>
