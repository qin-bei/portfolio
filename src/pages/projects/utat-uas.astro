---
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;

const contributions = [
  {
    title: "Winch mechanism",
    category: "MECHANICAL DESIGN",
    description:
      "Iterated design and tested an aerodynamic winch, gearbox, and plunger system for autonomous water retrieval and transport in a wildfire rescue simulation.",
    icon: "◇",
    color: "sage",
  },
  {
    title: "Payload baffle system",
    category: "PAYLOAD DESIGN",
    description:
      "Iterated design payload baffle structures to mitigate water sloshing and improve dynamic aerial stability.",
    icon: "○",
    color: "blue",
  },
  {
    title: "Structural validation",
    category: "ENGINEERING ANALYSIS",
    description:
      "Validated base-plate strength using static and modal FEA in ANSYS, achieving a safety factor of 2 under loading.",
    icon: "＋",
    color: "yellow",
  },
];

const gallery = [
  {
    src: `${base}images/UTAT_UAS/UTAT_UAS_baffle_system_CAD.png`,
    alt: "CAD design of the UTAT UAS payload baffle system",
    caption: "PAYLOAD BAFFLE SYSTEM · CAD",
  },
  {
    src: `${base}images/UTAT_UAS/UTAT_UAS_winch_CAD.png`,
    alt: "CAD design of the UTAT UAS water retrieval winch mechanism",
    caption: "WATER RETRIEVAL WINCH · CAD",
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Qin Bei's mechanical sub-team work with the University of Toronto Aerospace Team's Unmanned Aerial Systems team, including a wildfire-response water retrieval system and payload design."
    />
    <meta name="theme-color" content="#f7f5ef" />
    <title>U of T Aerospace Team Unmanned Aerial Systems — Qin Bei</title>
  </head>

  <body>
    <header class="nav">
      <a class="wordmark" href={base}>Qin Bei<span>.</span></a>
      <nav aria-label="Main navigation">
        <a href={`${base}#work`}>Projects</a>
        <a href={`${base}#about`}>About</a>
        <a href={`${base}#experience`}>Experience</a>
        <a href={`${base}#contact`}>Contact ↗</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <a class="back-link" href={`${base}#work`}>← All projects</a>
        <p class="eyebrow">MECHANICAL DESIGN · STUDENT DESIGN TEAM</p>
        <h1>U of T Aerospace Team<br />Unmanned Aerial Systems<span>.</span></h1>
        <p class="subtitle">
          Mechanical sub-team member designing systems for an autonomous
          wildfire water-retrieval mission.
        </p>

        <div class="metadata">
          <div>
            <span class="meta-label">TIMELINE</span>
            <span>September 2024 – June 2025</span>
          </div>
          <div>
            <span class="meta-label">ROLE</span>
            <span>Mechanical Sub-Team Member</span>
          </div>
          <div>
            <span class="meta-label">TOOLS</span>
            <span>SolidWorks · ANSYS</span>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="section-index">01</div>
        <div class="section-content overview">
          <h2>Project overview</h2>
          <p>
            The University of Toronto Aerospace Team (UTAT)'s Unmanned Aerial Systems
            (UAS) team developed an aircraft payload for a wildfire rescue simulation
            at the AEAC Student UAS Competition. As a mechanical sub-team
            member, I worked on water retrieval and transport hardware, payload
            stability, and structural analysis.
          </p>
        </div>
      </section>

      <section class="section contributions-section">
        <div class="section-index">02</div>
        <div class="section-content">
          <h2>My contributions</h2>
          <div class="contributions-grid">
            {contributions.map((item) => (
              <article class="contribution-item">
                <div class:list={["contribution-icon", item.color]} aria-hidden="true">
                  {item.icon}
                </div>
                <div class="contribution-copy">
                  <p class="contribution-category">{item.category}</p>
                  <h3>{item.title}</h3>
                  <p class="contribution-description">{item.description}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section results-section">
        <div class="section-index">03</div>
        <div class="section-content">
          <h2>Results</h2>
          <p class="section-intro">
            The design was recognized for its payload concept and team
            performance at the AEAC Student UAS Competition.
          </p>
          <div class="results-grid">
            <article class="result">
              <span class="result-number">Top 4</span>
              <p class="result-title">Overall competition placement</p>
              <p class="result-detail">
                Placed among the top four teams overall at the competition.
              </p>
            </article>
            <article class="result">
              <span class="result-number result-award" aria-hidden="true">✳</span>
              <p class="result-title">Innovation Award</p>
              <p class="result-detail">
                Recognized with the award for Best Payload Design.
              </p>
            </article>
            <article class="result">
              <span class="result-number">2<span>×</span></span>
              <p class="result-title">Structural safety factor</p>
              <p class="result-detail">
                ANSYS static and modal FEA supported a safety factor of 2
                under loading for the base plate.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="section gallery-section">
        <div class="section-index">04</div>
        <div class="section-content">
          <div class="gallery-heading">
            <div>
              <p class="eyebrow">SELECTED PROJECT IMAGES</p>
              <h2>Payload &amp; mechanism design<span>.</span></h2>
            </div>
            <span class="image-count">{gallery.length} IMAGES</span>
          </div>
          <div class="gallery-grid">
            {gallery.map((item, index) => (
              <figure class="gallery-item">
                <a
                  class="gallery-image"
                  href={item.src}
                  target="_blank"
                  rel="noreferrer"
                  aria-label={`Open full-size image: ${item.alt}`}
                >
                  <img src={item.src} alt={item.alt} loading="lazy" />
                  <span class="image-open" aria-hidden="true">↗</span>
                </a>
                <figcaption>
                  <span>{item.caption}</span>
                  <span class="image-index">{String(index + 1).padStart(2, "0")}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>

      <section class="next-project">
        <p class="eyebrow">MORE PROJECTS</p>
        <h2>More things I've been building<span>.</span></h2>
        <a href={`${base}#work`}>Back to selected projects ↗</a>
      </section>
    </main>

    <footer>
      <a class="wordmark" href={base}>Qin Bei<span>.</span></a>
      <span>MECHANICAL ENGINEERING</span>
      <a href={`${base}#contact`}>GET IN TOUCH ↗</a>
    </footer>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; scroll-padding-top: 80px; }
  :global(body) {
    margin: 0;
    background: #f7f5ef;
    color: #252620;
    font-family: Arial, Helvetica, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  :global(a) { color: inherit; text-decoration: none; }
  .nav, footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 22px 5.5%;
  }
  .nav { min-height: 72px; border-bottom: 1px solid #dedbd2; }
  .wordmark { font-size: 19px; font-weight: 700; letter-spacing: -0.7px; }
  .wordmark span, h1 span, h2 span { color: #648365; }
  nav { display: flex; gap: clamp(18px, 3vw, 42px); }
  nav a, .back-link { color: #55574f; font-size: 12px; }
  nav a:hover, .back-link:hover { color: #648365; }
  h1, h2, h3 { font-weight: 500; }
  .eyebrow, .meta-label {
    color: #72766b;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 1.4px;
    line-height: 1.7;
  }
  h2 {
    margin: 0 0 18px;
    font-size: clamp(28px, 3.1vw, 40px);
    line-height: 1.12;
    letter-spacing: -0.065em;
  }
  .hero { padding: 34px 5.5% 32px; }
  .back-link { display: inline-block; margin-bottom: 28px; }
  .hero > .eyebrow { margin: 0 0 16px; }
  h1 {
    margin: 0;
    font-size: clamp(38px, 5.2vw, 72px);
    line-height: 1.02;
    letter-spacing: -0.075em;
  }
  .subtitle {
    max-width: 650px;
    margin: 20px 0 0;
    color: #686961;
    font-size: 14px;
    line-height: 1.85;
  }
  .metadata {
    display: grid;
    grid-template-columns: 1fr 1.3fr 1fr;
    gap: 24px;
    max-width: 900px;
    margin-top: 30px;
    padding-top: 18px;
    border-top: 1px solid #dedbd2;
  }
  .metadata > div { display: flex; flex-direction: column; gap: 7px; padding-right: 15px; }
  .metadata > div + div { padding-left: 24px; border-left: 1px solid #d7d4cb; }
  .metadata > div > span:last-child { font-size: 12px; line-height: 1.65; }
  .section {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    column-gap: 14px;
    margin: 0 5.5%;
    padding: 32px 0;
    border-top: 1px solid #dedbd2;
  }
  .section-index { padding-top: 3px; color: #648365; font-size: 11px; }
  .section-content { min-width: 0; }
  .overview { max-width: 900px; }
  .overview p, .section-intro {
    max-width: 850px;
    color: #65675e;
    font-size: 13px;
    line-height: 1.85;
  }
  .overview p { margin: 0; }
  .section-intro { margin: 0 0 24px; }
  .contributions-section { padding-top: 30px; padding-bottom: 30px; }
  .contributions-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .contribution-item {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    align-content: start;
    gap: 16px;
    min-width: 0;
    padding: 0 24px;
  }
  .contribution-item:first-child { padding-left: 0; }
  .contribution-item:last-child { padding-right: 0; }
  .contribution-item + .contribution-item { border-left: 1px solid #d7d4cb; }
  .contribution-icon { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; font-size: 25px; line-height: 1; }
  .sage { background: #e1e7d7; color: #476448; }
  .blue { background: #dce7ef; color: #365d7c; }
  .yellow { background: #f7e6b9; color: #80652a; }
  .contribution-category { margin: 2px 0 9px; color: #72766b; font-size: 10px; font-weight: 500; letter-spacing: 1.2px; line-height: 1.5; }
  .contribution-copy h3 { margin: 0 0 12px; font-size: clamp(17px, 1.5vw, 22px); line-height: 1.25; letter-spacing: -0.4px; }
  .contribution-description { margin: 0; color: #65675e; font-size: 12px; line-height: 1.8; }
  .results-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  .result { min-width: 0; }
  .result-number { display: block; margin-bottom: 12px; font-size: clamp(34px, 4.4vw, 54px); line-height: 1; letter-spacing: -0.075em; font-weight: 500; }
  .result-number span { color: #648365; }
  .result-award { color: #648365; }
  .result-title { margin: 0 0 8px; font-size: 13px; font-weight: 600; }
  .result-detail { margin: 0; color: #65675e; font-size: 12px; line-height: 1.75; }
  .gallery-heading { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 24px; }
  .gallery-heading .eyebrow { margin: 0 0 8px; }
  .gallery-heading h2 { margin: 0; }
  .image-count { padding-bottom: 5px; color: #72766b; font-size: 10px; letter-spacing: 1px; white-space: nowrap; }
  .gallery-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 26px 18px; }
  .gallery-item { min-width: 0; margin: 0; }
  .gallery-image { position: relative; display: block; overflow: hidden; background: transparent; }
  .gallery-image img { display: block; width: 100%; aspect-ratio: 1.25 / 1; object-fit: contain; transition: transform 250ms ease; }
  .gallery-image:hover img { transform: scale(1.025); }
  .image-open { position: absolute; right: 10px; bottom: 10px; display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: #f7f5ef; opacity: 0; transition: opacity 180ms ease; }
  .gallery-image:hover .image-open, .gallery-image:focus-visible .image-open { opacity: 1; }
  figcaption { display: flex; justify-content: space-between; gap: 12px; padding: 10px 0; color: #72746b; font-size: 9px; letter-spacing: 0.9px; line-height: 1.6; }
  .image-index { color: #648365; }
  .next-project { padding: 35px 5.5% 42px; background: #eee9dc; }
  .next-project .eyebrow { margin: 0 0 12px; }
  .next-project h2 { margin-bottom: 20px; font-size: clamp(29px, 4vw, 44px); }
  .next-project > a { display: inline-block; padding-bottom: 7px; border-bottom: 1px solid #999b8d; font-size: 12px; }
  footer { color: #77786f; font-size: 9px; letter-spacing: 0.7px; }
  @media (min-width: 1500px) {
    .nav, .hero, .next-project, footer { padding-left: max(5.5%, calc((100% - 1320px) / 2)); padding-right: max(5.5%, calc((100% - 1320px) / 2)); }
    .section { margin-left: max(5.5%, calc((100% - 1320px) / 2)); margin-right: max(5.5%, calc((100% - 1320px) / 2)); }
  }
  @media (max-width: 900px) {
    .contributions-grid, .results-grid { grid-template-columns: 1fr; gap: 22px; }
    .contribution-item, .contribution-item:first-child, .contribution-item:last-child { padding: 0; }
    .contribution-item + .contribution-item { padding-top: 22px; border-top: 1px solid #d7d4cb; border-left: 0; }
    .metadata { grid-template-columns: 1fr 1fr; }
    .metadata > div:last-child { grid-column: 1 / -1; padding-left: 0; border-left: 0; }
  }
  @media (max-width: 480px) {
    .nav, footer { padding-left: 5%; padding-right: 5%; }
    nav { gap: 13px; }
    nav a { font-size: 10px; }
    .hero, .next-project { padding-left: 5%; padding-right: 5%; }
    .hero { padding-top: 22px; }
    .section { margin-left: 5%; margin-right: 5%; padding: 26px 0; }
    .metadata { grid-template-columns: 1fr; gap: 16px; }
    .metadata > div + div { padding-left: 0; border-left: 0; }
    .metadata > div:last-child { grid-column: auto; }
    .metadata > div > span:last-child { font-size: 11px; }
    .gallery-grid { grid-template-columns: 1fr; gap: 20px; }
    .gallery-heading { align-items: flex-start; flex-direction: column; gap: 10px; }
    footer { flex-wrap: wrap; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
    .gallery-image img, .image-open { transition: none; }
  }
</style>
