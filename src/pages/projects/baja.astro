
---
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;

const project = {
  timeline: "September 2024 – Present",
  role: "Team Founder · Captain · Chassis Lead",
  tools: "SolidWorks · ANSYS",
};

const contributions = [
  {
    number: "01",
    title: "Chassis design & fabrication",
    category: "MECHANICAL DESIGN",
    description:
      "Designed two iterations of a steel tubular chassis in SolidWorks, integrating drivetrain, suspension, steering, and braking systems around packaging and competition safety requirements. The next stage is translating the CAD design into a physical frame through metal fabrication and welding.",
    icon: "◇",
    color: "sage",
  },
  {
    number: "02",
    title: "Team leadership",
    category: "TEAM LEADERSHIP",
    description:
      "Re-founded starting from scratch and leading a team of 50+ students across seven subteams, coordinating two dedicated design spaces with university stakeholders.",
    icon: "○",
    color: "blue",
  },
  {
    number: "03",
    title: "Funding & operations",
    category: "FUNDING & OPERATIONS",
    description:
      "Secured $21,000 in grant funding to establish a budget for vehicle construction, manufacturing, and testing.",
    icon: "＋",
    color: "yellow",
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Qin Bei's Baja SAE chassis design, vehicle development, and team leadership."
    />
    <meta name="theme-color" content="#f7f5ef" />
    <title>U of T Baja Racing — Qin Bei</title>
  </head>

  <body>
    <header class="nav">
      <a class="wordmark" href={base}>Qin Bei<span>.</span></a>

      <nav aria-label="Main navigation">
        <a href={`${base}#work`}>Projects</a>
        <a href={`${base}#about`}>About</a>
        <a href={`${base}#experience`}>Experience</a>
        <a href={`${base}#contact`}>Contact ↗</a>
      </nav>
    </header>

    <main>
      <!-- PROJECT INTRODUCTION -->
      <section class="hero">
        <div class="hero-copy">
          <a class="back-link" href={`${base}#work`}>← All projects</a>

          <p class="eyebrow">
            VEHICLE ENGINEERING · MECHANICAL DESIGN · STUDENT DESIGN TEAM
          </p>

          <h1>U of T Baja<br />Racing<span>.</span></h1>

          <p class="subtitle">
            Rebuilding an off-road racing team from team leadership, business and design.
          </p>
        </div>

        <div class="metadata">
          <div>
            <span class="meta-label">TIMELINE</span>
            <span>{project.timeline}</span>
          </div>

          <div>
            <span class="meta-label">ROLE</span>
            <span>{project.role}</span>
          </div>

          <div>
            <span class="meta-label">TOOLS</span>
            <span>{project.tools}</span>
          </div>
        </div>
      </section>

      <!-- PROJECT OVERVIEW -->
      <section class="overview section">
        <div class="section-index">01</div>

        <div class="overview-copy">
          <h2>Project overview</h2>

          <p>
            U of T Baja Racing is a multidisciplinary student design team
            designing and building an off-road vehicle for international
            Baja SAE competition. Following the team's revival in 2024,
            I've helped rebuild its technical, organizational, and
            financial foundation.
          </p>
        </div>
      </section>

      <!-- CONTRIBUTIONS -->
      <section class="contributions section">
        <div class="section-index">02</div>

        <div class="section-content">
          <h2>My contributions</h2>

          <div class="contribution-grid">
            {contributions.map((item) => (
              <article class="contribution">
                <div
                  class:list={["contribution-icon", item.color]}
                  aria-hidden="true"
                >
                  {item.icon}
                </div>

                <div class="contribution-copy">
                  <p class="contribution-category">
                    {item.category}
                  </p>

                  <h3>{item.title}</h3>

                  <p class="contribution-description">
                    {item.description}
                  </p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- CHASSIS DESIGN -->
      <section class="chassis section">
        <div class="section-index">03</div>

        <div class="section-content">
          <div class="gallery-heading">
            <div>
              <p class="eyebrow">SELECTED PROJECT IMAGES</p>
              <h2>Chassis design</h2>
            </div>
            <span class="image-count">01 IMAGE</span>
          </div>

          <div class="chassis-gallery">
            <div class="gallery-note">
              <span class="note-number">DESIGN → BUILD</span>

              <p>
                Two chassis iterations developed around component
                integration, packaging, and competition requirements.
              </p>
              
            </div>

            <figure class="chassis-photo">
              <img
                src={`${base}images/baja/baja_chassis_render.jpg`}
                alt="SolidWorks CAD render of the Baja SAE tubular chassis"
                loading="lazy"
              />
              <figcaption>
                STEEL TUBULAR CHASSIS · CAD DESIGN
              </figcaption>
            </figure>
          </div>
        </div>
      </section>

      <!-- NEXT PROJECT -->
      <section class="next-project">
        <p class="eyebrow">MORE PROJECTS</p>

        <h2>
          More things I've been building<span>.</span>
        </h2>

        <a href={`${base}#work`}>Back to selected projects ↗</a>
      </section>
    </main>

    <footer>
      <a class="wordmark" href={base}>Qin Bei<span>.</span></a>

      <span>MECHANICAL ENGINEERING</span>

      <a href={`${base}#contact`}>GET IN TOUCH ↗</a>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 80px;
  }

  :global(body) {
    margin: 0;
    background: #f7f5ef;
    color: #252620;
    font-family: Arial, Helvetica, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  /* NAVIGATION */

  .nav {
    min-height: 72px;
    padding: 0 5.5%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #dedbd2;
  }

  .wordmark {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.7px;
  }

  .wordmark span,
  h1 span,
  .next-project h2 span {
    color: #648365;
  }

  nav {
    display: flex;
    gap: clamp(18px, 3vw, 42px);
  }

  nav a {
    color: #55574f;
    font-size: 12px;
    transition: color 180ms ease;
  }

  nav a:hover,
  .back-link:hover {
    color: #648365;
  }

  /* TYPOGRAPHY */

  h1,
  h2,
  h3 {
    font-family: Arial, Helvetica, sans-serif;
    font-weight: 400;
  }

  .eyebrow,
  .meta-label {
    color: #72766b;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 1.4px;
    line-height: 1.7;
  }

  h2 {
    margin: 0 0 18px;
    font-size: clamp(28px, 3.1vw, 40px);
    line-height: 1.1;
    letter-spacing: -0.065em;
    font-weight: 500;
  }

  /* HERO */

  .hero {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    column-gap: 38px;
    align-items: center;
    padding: 28px 5.5% 24px;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 32px;
    color: #686a60;
    font-size: 12px;
  }

  .hero-copy > .eyebrow {
    margin-bottom: 16px;
  }

  h1 {
    margin: 0;
    font-size: clamp(50px, 6.2vw, 84px);
    line-height: 0.96;
    letter-spacing: -0.075em;
    font-weight: 500;
  }

  .subtitle {
    max-width: 390px;
    margin: 20px 0 0;
    color: #686961;
    font-size: 15px;
    line-height: 1.75;
  }

  /* PROJECT DETAILS */

  .metadata {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1fr 1.3fr 1fr;
    gap: 24px;
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid #dedbd2;
  }

  .metadata > div {
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding-right: 15px;
  }

  .metadata > div + div {
    padding-left: 24px;
    border-left: 1px solid #d7d4cb;
  }

  .metadata > div > span:last-child {
    font-size: 12px;
    line-height: 1.65;
  }

  /* SHARED SECTIONS */

  .section {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    column-gap: 14px;
    margin: 0 5.5%;
    padding: 28px 0;
    border-top: 1px solid #dedbd2;
  }

  .section-index {
    padding-top: 3px;
    color: #648365;
    font-size: 11px;
  }

  .section-content,
  .overview-copy {
    min-width: 0;
  }

  /* OVERVIEW */

  .overview-copy p {
    max-width: 680px;
    margin: 0;
    color: #65675e;
    font-size: 13px;
    line-height: 1.8;
  }

  /* CONTRIBUTIONS */

  .contribution-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .contribution {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    align-content: start;
    gap: 12px;
    padding-right: 16px;
  }

  .contribution + .contribution {
    padding-left: 18px;
    border-left: 1px solid #d7d4cb;
  }

  .contribution-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    font-size: 24px;
    color: #354b39;
  }

  .sage {
    background: #e1e7d7;
  }

  .blue {
    background: #dce6ef;
    color: #354a61;
  }

  .yellow {
    background: #f8e6bc;
    color: #765a24;
  }

  .contribution-category {
    margin: 0 0 7px;
    color: #74766b;
    font-size: 9px;
    letter-spacing: 1px;
    line-height: 1.5;
  }

  .contribution h3 {
    margin: 0 0 8px;
    font-size: 18px;
    line-height: 1.3;
    letter-spacing: -0.6px;
    font-weight: 500;
  }

  .contribution-description {
    margin: 0;
    color: #65675e;
    font-size: 12px;
    line-height: 1.75;
  }

  /* CHASSIS DESIGN */

  .gallery-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 12px;
  }

  .gallery-heading .eyebrow {
    margin: 0 0 8px;
  }

  .gallery-heading h2 {
    margin: 0;
  }

  .image-count {
    padding-bottom: 5px;
    color: #72766b;
    font-size: 10px;
    letter-spacing: 1px;
    white-space: nowrap;
  }

  .chassis-gallery {
    display: block;
  }

  .gallery-note {
    padding: 12px 0;
    color: #65675e;
  }

  .note-number {
    color: #648365;
    font-size: 9px;
    letter-spacing: 1px;
  }

  .gallery-note p {
    font-size: 12px;
    line-height: 1.75;
  }

  .gallery-note .note-status {
    color: #648365;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.6px;
  }

  .chassis-photo {
    width: 100%;
    margin-top: 24px;
  }

  .chassis-photo img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .chassis-photo figcaption {
    padding: 10px 0;
    color: #72746b;
    font-size: 9px;
    letter-spacing: 1px;
  }

  /* NEXT PROJECT */

  .next-project {
    margin-top: 8px;
    padding: 36px 5.5% 45px;
    background: #eee9dc;
  }

  .next-project .eyebrow {
    margin: 0 0 12px;
  }

  .next-project h2 {
    margin-bottom: 20px;
    font-size: clamp(30px, 4vw, 46px);
    line-height: 1.08;
    letter-spacing: -0.07em;
  }

  .next-project > a {
    display: inline-block;
    padding-bottom: 7px;
    border-bottom: 1px solid #999b8d;
    font-size: 12px;
  }

  /* FOOTER */

  footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 24px 5.5%;
    color: #77786f;
    font-size: 9px;
    letter-spacing: 0.7px;
  }

  /* LARGE SCREENS */

  @media (min-width: 1500px) {
    .nav,
    .hero,
    .next-project,
    footer {
      padding-left: max(5.5%, calc((100% - 1320px) / 2));
      padding-right: max(5.5%, calc((100% - 1320px) / 2));
    }

    .section {
      margin-left: max(5.5%, calc((100% - 1320px) / 2));
      margin-right: max(5.5%, calc((100% - 1320px) / 2));
    }
  }

  /* TABLETS */

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .metadata {
      grid-template-columns: 1fr 1fr;
    }

    .metadata > div:last-child {
      grid-column: 1 / -1;
      padding-left: 0;
      border-left: 0;
    }

    .overview {
      grid-template-columns: 25px minmax(0, 1fr);
    }

    .contribution-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .contribution,
    .contribution + .contribution {
      padding: 0 0 20px;
      border-left: 0;
      border-bottom: 1px solid #dedbd2;
    }

    .contribution:last-child {
      padding-bottom: 0;
      border-bottom: 0;
    }
  }

  /* PHONES */

  @media (max-width: 480px) {
    .nav {
      min-height: 64px;
      padding: 0 5%;
    }

    nav {
      gap: 13px;
    }

    nav a {
      font-size: 10px;
    }

    .hero {
      padding: 22px 5%;
    }

    h1 {
      font-size: 57px;
    }

    .back-link {
      margin-bottom: 25px;
    }

    .section {
      grid-template-columns: 22px minmax(0, 1fr);
      gap: 10px;
      margin: 0 5%;
      padding: 23px 0;
    }

    .metadata {
      gap: 15px;
    }

    .metadata > div + div {
      padding-left: 13px;
    }

    .metadata > div:first-child {
      padding-right: 0;
    }

    .metadata > div > span:last-child {
      font-size: 10px;
    }

    .next-project {
      padding: 30px 5% 38px;
    }

    footer {
      flex-wrap: wrap;
      padding: 20px 5%;
    }
  }

  /* ACCESSIBILITY */

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
  }
</style>
